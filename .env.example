# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# DATABASE_URL: PostgreSQL or SQLite connection string
DATABASE_URL="postgres://postgres:password@postgres:5432/cinevicino"

# TMDB_API_KEY: The Movie Database API key for metadata & poster enrichment
TMDB_API_KEY=""

# FIRECRAWL_API_KEY: Firecrawl API key for one-time discovery crawls & JS pages (1,000 credits/mo free tier)
FIRECRAWL_API_KEY=""

# EMAIL_ALERT_API_KEY: Resend / SendGrid / SMTP key for movie release alerts
EMAIL_ALERT_API_KEY=""

# ADMIN_PASSWORD: Password for the protected /admin dashboard (default: admin123)
ADMIN_PASSWORD="admin"
