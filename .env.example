# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY=""

# APP_URL: The URL where this applet is hosted.
APP_URL=""

# SITE_URL: The public URL people access the site at (e.g. https://cinemavicino.minhazbinsanto.com)
SITE_URL="https://cinemavicino.minhazbinsanto.com"

# DATABASE_URL: PostgreSQL connection string (defaults to embedded PGlite at data/pgdata if omitted)
DATABASE_URL="postgres://postgres:password@postgres:5432/cinevicino"

# JWT_SECRET: Required. Cryptographically secure secret key for signing admin session tokens (minimum 32 characters).
# Generate using: openssl rand -hex 32
JWT_SECRET=""

# TMDB_API_KEY: The Movie Database API key for metadata & poster enrichment
TMDB_API_KEY=""

# FIRECRAWL_API_KEY: Firecrawl API key for one-time discovery crawls & JS pages (1,000 credits/mo free tier)
FIRECRAWL_API_KEY=""

# EMAIL_ALERT_API_KEY: Resend / SendGrid / SMTP key for movie release alerts
EMAIL_ALERT_API_KEY=""

# ADMIN_PASSWORD: Password for the protected /admin dashboard (minimum 8 characters, must not be trivial)
ADMIN_PASSWORD=""
